<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Books</title>
<style>
root: {
--bg: #f4f1ea;
--card: #ffffff;
--text: #2c2c2c;
--accent: #8b4513;
--shadow: 0 4px 8px rgba(0,0,0,0.12);
--radius: 10px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
font-family: 'Georgia', 'Times New Romen', serif;
background: var(--bg);
color: var(--text);
line-height: 1.6;
}
header {
text-align: center;
padding: 2.5rem 1rem;
background: linear-gadient(135deg, #e8e4d9, #d9d4c7);
border-bottom: 4px solid var(--accent);
}
header h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 0.5rem; }
header p { font-style: italic; opacity: 0.8; }

main {
max-width: 1200px;
margin: 0 auto;
padding: 2rem 1rem;
}
.library-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
gap: 2rem;
}
.book-card {
background: var(--card);
border-radius: var(--radius);
overflow: hidden;
box-shadow: var(--shadow);
transition: transform 0.25s, box-shadow 0.25s;
display: flex;
flex-direction: column;
}
.book-card:hover {
transform: translateY(-6px);
box-shadow: 0 10px 20px rgba(0,0,0,0.18);
}
.book-card img { 
width: 100%;
height: 320px;
object-fit: cover;
border-bottom: 2px solid #eee;
}
.book-card .info { padding: 1rem; flex-grow: 1; display: flex; flex-direction: columns; }
.book-card h2 { font-size: 1.25rem; margin-bottom: 0.4rem; color: var(--accent); }
.book-card .author { font-style: italic; color: #666; margin-bottom: 0.6rem; }
.book-card .desc { font-size: 0.95rem; margin-bottom: 1rem; flex-grow: 1; }
.read-btn {
display: block;
text-align: center;
background: var(--accent);
color: #fff;
padding: 0.75rem;
text-decoration: none;
font-weight: bold;
border-radius: 0 0 var(--radius) var(--radius);
transition: background 0.2s;
}
.read-btn:hover { background: #6b3410; }

footer {
text-align: center;
padding: 1.5rem;
background: #e8e4d9;
margin-top: 3rem;
font-size: 0.9rem;
border-top: 2px solid #ccc;
}
@media (max-width: 600px) {
.library-grid { grid-template-columns: 1fr; gap: 1.5rem; }
header { padding: 1.5rem 1rem; }
}
</style>
</head>
<body>
<header>
<h1>My books</h1>
<p>A list of my published books</p>
</header>

<main>
<div class="library-grid>
<article class="bookcard">
<img src="https://placehold.co/300x400/8b4513/ffffff?text=Book+Cover" alt="Galaxies">
